# Copy this file to backend/.env (local) or set the same variables in your
# hosting dashboard (Render > Environment). Never commit the real values.

# --- Database -------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME

# --- Login tokens ---------------------------------------------------------
# Any long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me
JWT_ACCESS_TOKEN_MINUTES=60

# --- Backblaze B2 (private bucket) ---------------------------------------
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
B2_ENDPOINT_URL=https://s3.us-east-005.backblazeb2.com

# --- CORS (optional) ------------------------------------------------------
# Comma-separated list of frontend origins allowed to call this API.
# CORS_ORIGINS=https://movieshare.onrender.com,http://localhost:5173
